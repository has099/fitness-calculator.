import streamlit as st

st.set_page_config(page_title="المساعد الرياضي الشامل", page_icon="🏋️‍♂️", layout="centered")

st.title("🏋️‍♂️ المساعد الرياضي وحاسبة اللياقة الشاملة")
st.write("حاسبتك الذكية لتحديد السعرات، الماكروز، واحتياج الماء والتمارين!")

st.divider()

# المدخلات الأساسية
col_in1, col_in2 = st.columns(2)
with col_in1:
    weight = st.number_input("الوزن (كغم):", min_value=30.0, max_value=200.0, value=70.0, step=0.5)
    age = st.number_input("العمر:", min_value=10, max_value=100, value=20)
with col_in2:
    height = st.number_input("الطول (سم):", min_value=100.0, max_value=220.0, value=170.0, step=1.0)
    steps = st.number_input("الخطوات اليومية:", min_value=0, max_value=50000, value=8000, step=500)

goal = st.selectbox("🎯 ما هو هدفك الحالي؟", ["تنزيل وزن", "بناء عضلات", "المحافظة على الوزن"])

if st.button("🚀 احسب خطتك الكاملة", type="primary"):
    # 1. الحسابات الأساسية
    bmr = (10 * weight) + (6.25 * height) - (5 * age) + 5
    step_calories = (steps / 1000) * 40
    total_calories = bmr + step_calories
    
    # تحديد السعرات حسب الهدف
    if goal == "تنزيل وزن":
        target_calories = total_calories - 400
    elif goal == "بناء عضلات":
        target_calories = total_calories + 300
    else:
        target_calories = total_calories

    # 2. حساب الماكروز (التوزيع الغذائي)
    protein_g = weight * 2.0                # 2g لكل كغم
    fat_g = weight * 0.9                   # 0.9g دهون صحية لكل كغم
    protein_cal = protein_g * 4
    fat_cal = fat_g * 9
    carb_cal = max(0, target_calories - (protein_cal + fat_cal))
    carb_g = carb_cal / 4                  # المتبقي كربوهيدرات

    # 3. احتساب الماء
    water_l = weight * 0.033

    st.success("✨ تم تجهيز خطتك الرياضية بنجاح!")

    # عرض النتائج في بطاقات
    c1, c2 = st.columns(2)
    c1.metric("حرق الجسم الأساسي (BMR)", f"{round(bmr)} سعرة")
    c2.metric("السعرات المستهدفة لهدفك", f"{round(target_calories)} سعرة")

    st.divider()

    # قسم الماكروز والماء
    st.subheader("📊 توزيع الماكروز اليومي (Macronutrients)")
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("🥩 بروتين", f"{round(protein_g)} غرام")
    m2.metric("🍚 كربوهيدرات", f"{round(carb_g)} غرام")
    m3.metric("🥑 دهون صحية", f"{round(fat_g)} غرام")
    m4.metric("💧 ماء", f"{round(water_l, 1)} لتر")

    st.divider()

    # قسم النصائح والتمارين
    st.subheader("💡 توصيات التغذية والتمارين لهدفك")
    if goal == "تنزيل وزن":
        st.warning("🔥 **خطة التنزيل:** ركّز على الأغذية الغنية بالبروتين والألياف لزيادة الشبع، واعتمد تمارين الكارديو (مشي، قفز حبل) مع تمارين المقاومة لحفظ العضلات.")
    elif goal == "بناء عضلات":
        st.success("💪 **خطة البناء:** اهتم بوجبة ما بعد التمرين (بروتين + كربوهيدرات معقدة)، وركز على تمارين الضغط، السكوات، والأوزان لزيادة الحجم العضلي.")
    else:
        st.info("⚖️ **خطة المحافظة:** حافظ على استقرار نشاطك اليومي ووازّن وجباتك بنفس النسب الموضحة أعلاه.")
